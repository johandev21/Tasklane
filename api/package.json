{
  "name": "@tasklane/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/db/schema.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.29",
    "ulid": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.5",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "check": "prettier --check .",
    "format": "prettier --write ."
  }
}
